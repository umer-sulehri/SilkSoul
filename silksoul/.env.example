# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side service role (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Admin demo login (used ONLY when Supabase is not configured)
# Change these before deploying — the defaults below are public demo credentials.
ADMIN_EMAIL=admin@silksoul.com
ADMIN_PASSWORD=admin1234
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Currency
NEXT_PUBLIC_CURRENCY=PKR